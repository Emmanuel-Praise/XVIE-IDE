# Xvie browser-agent sidecar (.env example)
# Copy to .env and adjust. All values have built-in defaults.
XVIE_BROWSER_AGENT_PORT=28711
# Dedicated CDP port for the hidden chat window. Do NOT use 9222 — Xvie's
# Electron app and mcp-web-llm both use it, which breaks tab routing.
MCP_WEB_LLM_CDP_PORT=9333
# Own Chrome profile (defaults to ~/.xvie-browser-agent/chrome-profile).
# Keep it separate from C:\chrome_debug_profile to avoid profile-lock fights.
# MCP_WEB_LLM_PROFILE_DIR=C:\Users\HP\.xvie-browser-agent\chrome-profile
# MCP_WEB_LLM_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# XVIE_BROWSER_HEADLESS=1 starts the window invisible (default).
# Set to 0 to start visible (useful for first-time logins).
# XVIE_BROWSER_ANSWER_TIMEOUT_S=150
# XVIE_BROWSER_ASK_TIMEOUT_S=180
