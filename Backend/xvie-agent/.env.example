# ─────────────────────────────────────────────────────────────────────────────
# xvie-agent configuration
#
# Provider keys follow the FORGE_PROVIDER_<NAME>_ convention.
# Add as many providers as you like — just add two env vars each.
# ─────────────────────────────────────────────────────────────────────────────

# ── NVIDIA NIM (free tier available) ──────────────────────────────────────────
FORGE_PROVIDER_NVIDIA_API_KEY=nvapi-...
FORGE_PROVIDER_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── OpenRouter (free models available) ────────────────────────────────────────
# FORGE_PROVIDER_OPENROUTER_API_KEY=sk-or-v1-...
# FORGE_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Any other OpenAI-compatible provider ──────────────────────────────────────
# FORGE_PROVIDER_TOGETHER_API_KEY=...
# FORGE_PROVIDER_TOGETHER_BASE_URL=https://api.together.xyz/v1
#
# FORGE_PROVIDER_GROQ_API_KEY=gsk_...
# FORGE_PROVIDER_GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Defaults ──────────────────────────────────────────────────────────────────
# Which provider to use when none is specified
FORGE_DEFAULT_PROVIDER=nvidia

# Model to use (must be available on the default provider)
DEFAULT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional vision-capable model for desktop/mobile UI screenshot critique.
# Leave blank to try the active model; unsupported image input falls back to diagnostics only.
# XVIE_VISION_MODEL=<vision-capable model on the configured provider>

# Agent loop limits
MAX_TURNS=12
BUDGET_TOKENS=100000
LOG_LEVEL=INFO

# Optional image search provider. Without a key, image search uses Wikimedia Commons.
# Add your Pexels API key here to use Pexels first, with Commons as a fallback.
# PEXELS_API_KEY=your-pexels-api-key

# ── Zetaris live data (read-only analytics gateway) ──────────────────────
# http://localhost:3000 is the Zetaris UI origin (NOT the raw :8888 API port).
# Credentials come from your Zetaris admin. The repository has two tools when
# configured: zetaris_query (read-only SQL) and zetaris_catalog (discovery).
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_USERNAME=admin@zetaris.com
ZETARIS_PASSWORD=change-me
# Optional: learned automatically from the login response if not set.
# ZETARIS_ORG_ID=1
# Default max rows returned per query (prompt can override per call).
# ZETARIS_QUERY_LIMIT=200
# Per-request timeout in seconds.
# ZETARIS_TIMEOUT_SECONDS=30

# ── Meterless / Nightshift local model runtime ───────────────────────────
# Auto-detected from %LOCALAPPDATA%\ai.meterless.runtime\proxy-token on Windows.
# Override these only if your runtime uses a different location or model.
# METERLESS_TOKEN_PATH=C:\path\to\proxy-token
# METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# METERLESS_MODEL=worker

# ── Responsiveness tuning ─────────────────────────────────────────────────────
# Desktop Agent defaults to a 45 second model response timeout.
# Lower this if "Working…" hangs a long time on a stalled model.
# XVIE_PROVIDER_TIMEOUT=45
# Requests per minute per provider (default 35). Higher = less pacing delay,
# but more 429 rate limits on free tiers.
# RATE_LIMIT_RPM=35

# ── Seamless-run tuning (anti-stop + context diet) ────────────────────────────
# Wait-and-retry behavior: transient retries are bounded; rate-limit waits
# continue until a configured model becomes available or the user stops.
# XVIE_RETRY_MAX=1
# XVIE_RETRY_BASE_DELAY=2.0
# XVIE_RETRY_CAP=60.0
# Output-cap continuations: how many auto-continues after finish_reason=length
# (truncation) and stall-forcing nudges before giving up with a resume hint.
# XVIE_MAX_CONTINUATIONS=8
# XVIE_MAX_STALL_CONTINUATIONS=8
# Context diet: smaller prompts = fewer trims, fewer payload rejections.
# XVIE_MAX_REQUEST_CHARS=90000
# XVIE_MEMORY_CHARS=8000
# XVIE_INVENTORY_LIMIT=30
# XVIE_RELEVANT_CONTEXT_CHARS=6000
# XVIE_RESERVED_OUTPUT=4000
